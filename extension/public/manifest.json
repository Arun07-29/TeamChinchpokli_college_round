{
  "manifest_version": 3,
  "name": "IntentLock",
  "version": "1.0.0",
  "description": "Hands-free browser control via head/hand tracking and voice commands. No biometric data stored.",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage", "tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["mediapipe/*", "mediapipe/wasm/*"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["test.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open IntentLock"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
